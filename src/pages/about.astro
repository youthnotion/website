---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import GrowthArt from "@/components/ui/hero-art/GrowthArt.astro";
import Story from "@/components/sections/about/Story.astro";
import Faq from "@/components/sections/about/Faq.astro";
---

<BaseLayout
  title="About Youth Notion"
  description="Learn about Youth Notion, a youth-led organization in Maijdee, Noakhali, Bangladesh, and our work in youth empowerment, civic awareness, education, and technology."
>
  <PageHero
    eyebrow="Our purpose"
    title="A generation ready"
    accent="to shape what comes next."
    description="We help young people build the knowledge, skills, and confidence to make meaningful change in their communities."
    primary={{ label: "Our approach", href: "#approach" }}
    secondary={{ label: "Meet the team", href: "/team" }}
  >
    <GrowthArt slot="art" />
  </PageHero>
  <Story />
  <Faq />
</BaseLayout>
