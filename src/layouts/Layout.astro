---
import "../styles/index.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer";
import ScrollToTop from "../components/ScrollToTop";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Youth Notion",
  description = "We believe in youth. Youth Notion promotes civic awareness and youth empowerment through education and technology.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="!scroll-smooth" style="--font-kdam: Arial, sans-serif">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#246476" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <ScrollToTop client:load />
  </body>
</html>
