---
// Team: one star per person, built from the real team list. Directors are the
// brighter stars, and the caption introduces people one at a time.
import { team, isDirector } from "@/data/team";

// Directors first, so they settle near the middle of the constellation.
const members = [...team]
  .sort((a, b) => Number(isDirector(b)) - Number(isDirector(a)))
  .map((member) => ({ name: member.name, role: member.role, lead: isDirector(member) }));
---

<div class="constellation" data-constellation={JSON.stringify(members)}>
  <canvas></canvas>
  <p class="constellation__caption" data-caption>
    <strong>{team.length} people</strong>
    <span>One shared purpose</span>
  </p>
</div>

<script>
  import { mountConstellation } from "@/scripts/constellation";
  document.querySelectorAll<HTMLElement>("[data-constellation]").forEach(mountConstellation);
</script>

<style>
  .constellation {
    position: relative;
    width: 100%;
    height: 100%;
  }

  canvas {
    width: 100%;
    height: 100%;
  }

  .constellation__caption {
    position: absolute;
    left: 50%;
    bottom: -0.25rem;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    min-width: 70%;
    text-align: center;
    pointer-events: none;
  }

  strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  span {
    color: var(--lime);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
