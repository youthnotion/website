---
// One place for every icon on the site. Line icons use a 24px grid and
// `currentColor`, so they take the colour of their surrounding text.
const paths = {
  "arrow-right": `<path d="M5 12h14M13 6l6 6-6 6"/>`,
  "arrow-up-right": `<path d="M7 17 17 7M8 7h9v9"/>`,
  "arrow-down": `<path d="M12 5v14M6 13l6 6 6-6"/>`,
  plus: `<path d="M12 5v14M5 12h14"/>`,
  menu: `<path d="M4 8h16M4 16h16"/>`,
  close: `<path d="m6 6 12 12M18 6 6 18"/>`,
  pin: `<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4"/>`,
  // Objectives
  bridge: `<path d="M3 17h18M5 17v-4M19 17v-4M3 13c3-5 6-7 9-7s6 2 9 7M9 17v-3.5M15 17v-3.5M12 17v-4"/>`,
  spark: `<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/><circle cx="12" cy="12" r="2"/>`,
  stack: `<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/><path d="m3 17.5 9 4.5 9-4.5" opacity=".55"/>`,
  hands: `<circle cx="7" cy="6" r="2.2"/><circle cx="17" cy="6" r="2.2"/><path d="M3 20v-4a4 4 0 0 1 4-4h1.5l3.5 3.5L15.5 12H17a4 4 0 0 1 4 4v4"/>`,
} as const;

// Brand marks are filled, not stroked.
const brands = {
  facebook: `<path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.5 1.6-1.5h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V21h3.4Z"/>`,
  linkedin: `<path d="M5.2 3.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3.5 9h3.4v11.5H3.5V9Zm5.5 0h3.3v1.6h.1A3.7 3.7 0 0 1 15.7 8c3.5 0 4.2 2.3 4.2 5.3v7.2h-3.4v-6.4c0-1.5 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3v6.5H9V9Z"/>`,
  whatsapp: `<path d="M12.04 2a9.9 9.9 0 0 0-8.52 14.94L2.2 22l5.2-1.36A9.98 9.98 0 0 0 12.04 22h.01A10 10 0 0 0 12.04 2Zm0 18.3a8.28 8.28 0 0 1-4.22-1.15l-.3-.18-3.09.81.83-3.01-.2-.31A8.3 8.3 0 1 1 12.04 20.3Zm4.56-6.22c-.25-.13-1.47-.73-1.7-.81-.23-.08-.4-.13-.57.13-.17.25-.65.81-.8.98-.15.17-.3.19-.55.06-.25-.13-1.05-.39-2-1.24-.74-.66-1.24-1.48-1.39-1.73-.15-.25-.02-.39.11-.52.11-.11.25-.3.37-.44.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.57-1.37-.78-1.88-.21-.5-.42-.43-.57-.44h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.23.9 2.42 1.02 2.59.13.17 1.77 2.7 4.28 3.79.6.26 1.07.42 1.44.54.61.19 1.16.16 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.59.21-1.09.15-1.19-.07-.1-.23-.16-.48-.28Z"/>`,
} as const;

export type IconName = keyof typeof paths | keyof typeof brands;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;
const isBrand = name in brands;
const body = isBrand ? brands[name as keyof typeof brands] : paths[name as keyof typeof paths];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isBrand ? "currentColor" : "none"}
  stroke={isBrand ? "none" : "currentColor"}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={body}
/>
