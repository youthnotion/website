---
import Icon from "./Icon.astro";
import ProjectMark from "./ProjectMark.astro";
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<a
  href={project.href}
  target="_blank"
  rel="noopener noreferrer"
  class="project chamfer"
  style={{ "--accent": project.accent }}
>
  <div class="project__top">
    <div class="project__brand">
      <ProjectMark project={project} size={52} />
      <span class="project__name">{project.name}</span>
    </div>
    <span class="project__index">{String(index + 1).padStart(2, "0")}</span>
  </div>

  <div class="project__body">
    <p class="project__field">{project.field}</p>
    <p class="project__summary">{project.summary}</p>
  </div>

  <div class="project__foot">
    <span class="project__link">Visit project <Icon name="arrow-up-right" size={16} /></span>
  </div>
</a>

<style>
  .project {
    --cut: 18px;
    --chamfer-fill: var(--ink-2);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 240px;
    padding: 1.25rem 1.2rem 1rem;
    /* The glow below reaches past the card. clip-path hides it, but only this stops it widening the page. */
    overflow: hidden;
    transition: transform 0.45s var(--ease-out);
  }

  /* Stacked on phones, so no need to match a neighbour's height. */
  @media (max-width: 899px) {
    .project {
      min-height: 0;
    }

    .project__body {
      margin-top: 0.25rem;
    }
  }

  .project::after {
    content: "";
    position: absolute;
    inset: auto -20% -45% -20%;
    height: 80%;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 26%, transparent), transparent);
    opacity: 0.35;
    transition: opacity 0.45s;
  }

  .project:hover {
    --chamfer-line: color-mix(in srgb, var(--accent) 55%, transparent);
    transform: translateY(-6px);
  }

  .project:hover::after {
    opacity: 1;
  }

  .project__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .project__brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    flex: 1;
  }

  .project__name {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .project__index {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .project__body {
    display: grid;
    gap: 0.75rem;
    margin-top: auto;
  }

  .project__field {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project__summary {
    color: var(--muted);
    max-width: 44ch;
  }

  .project__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
  }


  .project__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    font-weight: 600;
  }

  .project:hover .project__link {
    color: var(--accent);
  }

</style>
