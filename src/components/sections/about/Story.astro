---
import Button from "@/components/ui/Button.astro";
import { journey } from "@/data/content";
---

<section class="section story" id="approach" aria-labelledby="story-title">
  <div class="container">
    <div class="story__intro" data-reveal>
      <p class="eyebrow">Why Youth Notion</p>
      <h2 id="story-title" class="title">Potential becomes progress when young people can take part.</h2>
      <div class="story__text">
        <p class="lede">
          Youth Notion helps young people understand the challenges around them, gain practical skills, and
          lead action that makes a difference in their communities.
        </p>
        <Button href="/projects" variant="ghost" icon="arrow-up-right">See what we’re building</Button>
      </div>
    </div>

    <div class="journey" data-journey>
      <span class="journey__rail" aria-hidden="true"><span></span></span>
      <ol
        class="journey__steps"
        role="list"
        aria-label="How Youth Notion turns potential into community impact"
      >
        {
          journey.map((step, index) => {
            const isOutcome = index === journey.length - 1;
            return (
              <li
                class:list={["journey__step", { "journey__step--outcome": isOutcome }]}
                data-reveal
                style={{ "--reveal-index": index }}
              >
                <span class="journey__node octagon" aria-hidden="true" />
                <p class="journey__label">{isOutcome ? "The outcome" : `0${index + 1} / The journey`}</p>
                <h3>{step.name}</h3>
                <p>{step.text}</p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>

<script>
  // Fill the rail as the journey scrolls through the viewport.
  const journey = document.querySelector<HTMLElement>("[data-journey]");
  if (journey) {
    const update = () => {
      const rect = journey.getBoundingClientRect();
      const progress = (window.innerHeight * 0.75 - rect.top) / rect.height;
      journey.style.setProperty("--progress", String(Math.min(1, Math.max(0, progress))));
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }
</script>

<style>
  .story__intro {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 960px) {
    .story__intro {
      grid-template-columns: 1.3fr 1fr;
      column-gap: 4rem;
    }

    .story__intro .eyebrow {
      grid-column: 1 / -1;
    }
  }

  .story__text {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    align-content: end;
  }

  .journey {
    --progress: 0;
    position: relative;
    padding-left: 2.75rem;
  }

  .journey__steps {
    display: grid;
    gap: 2.5rem;
  }

  .journey__rail {
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--line);
  }

  .journey__rail span {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--teal), var(--lime));
    transform-origin: top;
    transform: scaleY(var(--progress));
  }

  .journey__step {
    position: relative;
    display: grid;
    gap: 0.6rem;
  }

  .journey__node {
    position: absolute;
    left: calc(-2.75rem + 2px);
    top: 0;
    width: 20px;
    height: 20px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 2px var(--teal);
  }

  .journey__step--outcome .journey__node {
    background: var(--lime);
    box-shadow: 0 0 24px var(--lime);
  }

  .journey__label {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .journey__step h3 {
    font-size: clamp(1.3rem, 2vw, 1.6rem);
  }

  .journey__step--outcome h3 {
    color: var(--lime);
  }

  .journey__step p:last-child {
    color: var(--muted);
    max-width: 32ch;
  }

  /* Horizontal on wide screens */
  @media (min-width: 960px) {
    .journey {
      padding-left: 0;
      padding-top: 2.25rem;
    }

    .journey__steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }

    .journey__rail {
      left: 0;
      right: 0;
      top: 9px;
      bottom: auto;
      width: auto;
      height: 2px;
    }

    .journey__rail span {
      transform-origin: left;
      transform: scaleX(var(--progress));
    }

    .journey__node {
      left: 0;
      top: -2.25rem;
    }
  }
</style>
