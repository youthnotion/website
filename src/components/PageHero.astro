---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  actionLabel: string;
  actionHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  variant?: "about" | "team" | "projects";
}

import { teamData } from "@/data/team";

const {
  eyebrow,
  title,
  description,
  actionLabel,
  actionHref,
  secondaryLabel,
  secondaryHref,
  variant = "about",
} = Astro.props;
---

<section class="page-hero" data-variant={variant} aria-labelledby="page-hero-title">
  <div class="page-hero-grid" aria-hidden="true"></div>
  <div class="page-hero-glow" aria-hidden="true"></div>
  <div class="container page-hero-layout">
    <div class="page-hero-copy">
      <p class="page-hero-eyebrow"><span></span>{eyebrow}</p>
      <h1 id="page-hero-title">{title}</h1>
      <p class="page-hero-description">{description}</p>
      <div class="page-hero-actions">
        <a class="page-hero-primary" href={actionHref}>{actionLabel}<span aria-hidden="true">↗</span></a>
        {secondaryLabel && secondaryHref && <a class="page-hero-secondary" href={secondaryHref}>{secondaryLabel}<span aria-hidden="true">→</span></a>}
      </div>
      <p class="page-hero-footnote"><span></span> YOUTH-LED. FUTURE-READY.</p>
    </div>
    <div class="page-hero-art" aria-hidden="true">
      <div class="page-art-orbit orbit-a"></div>
      <div class="page-art-orbit orbit-b"></div>
      <div class="page-art-orbit orbit-c"></div>
      <div class="page-art-core"><span>{variant === "team" ? teamData.length : variant === "projects" ? "03" : "YN"}</span><small>{variant === "team" ? "PEOPLE IN MOTION" : variant === "projects" ? "IDEAS IN ACTION" : "POTENTIAL → PROGRESS"}</small></div>
      <canvas class="page-hero-canvas"></canvas>
      <span class="page-art-caption">MOVE WITH PURPOSE <b>✳</b></span>
    </div>
  </div>
  <div class="page-hero-bottom"><span>YOUTH NOTION</span><span>LEARN · CONNECT · LEAD</span><span>EST. FOR WHAT’S NEXT</span></div>
</section>

<style>
  .page-hero { min-height:650px;position:relative;isolation:isolate;overflow:hidden;display:flex;align-items:center;padding:142px 0 76px;background:#0d3035;color:#f5faf5; }
  .page-hero:before { content:"";position:absolute;inset:0;z-index:-2;background:radial-gradient(ellipse at 78% 48%,#17605699,transparent 45%),linear-gradient(118deg,#0b2831,#0e3a3d 65%,#102c37); }
  .page-hero-grid { position:absolute;inset:0;z-index:-1;opacity:.18;background-image:linear-gradient(#a5dbbd12 1px,transparent 1px),linear-gradient(90deg,#a5dbbd12 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(90deg,transparent,#000 40%,#000); }
  .page-hero-glow { position:absolute;z-index:-1;right:9%;top:11%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,#64d4aa22,transparent 68%);filter:blur(8px); }
  .page-hero-layout { display:grid;grid-template-columns:1fr .92fr;align-items:center;gap:36px; }
  .page-hero-copy { position:relative;z-index:2;max-width:650px; }
  .page-hero-eyebrow { display:flex;align-items:center;gap:11px;margin:0 0 24px;color:#b7e78d;font-size:11px;font-weight:700;letter-spacing:.19em;text-transform:uppercase; }
  .page-hero-eyebrow span { width:8px;height:8px;border-radius:50%;background:#b7e78d;box-shadow:0 0 16px #b7e78d; }
  .page-hero-copy h1 { margin:0;color:#f5faf5;font-size:clamp(3.3rem,6.5vw,5.8rem);font-weight:760;letter-spacing:-.065em;line-height:.99;text-wrap:balance; }
  .page-hero-description { max-width:520px;margin:25px 0 0;color:#bdcfcb;font-size:17px;line-height:1.75; }
  .page-hero-actions { display:flex;align-items:center;gap:28px;margin-top:32px; }
  .page-hero-primary { display:inline-flex;align-items:center;gap:24px;border-radius:6px;padding:15px 20px;background:#c5ed94;color:#153b3b;font-weight:700;box-shadow:0 8px 28px #b9e98920;transition:transform .2s,background .2s; }
  .page-hero-primary:hover { transform:translateY(-2px);background:#d5f5ad; }
  .page-hero-secondary { color:#f4faf5;font-weight:600; }.page-hero-secondary span { margin-left:10px;color:#bee995; }
  .page-hero-footnote { display:flex;align-items:center;gap:12px;margin:43px 0 0;color:#8caeaa;font-size:10px;letter-spacing:.16em;font-weight:650; }
  .page-hero-footnote span { width:28px;height:1px;background:#b9e78e; }
  .page-hero-art { position:relative;min-height:430px;display:grid;place-items:center; }
  .page-art-orbit { position:absolute;left:50%;top:50%;border:1px solid #9ad9ba28;border-radius:50%;transform:translate(-50%,-50%); }
  .orbit-a { width:min(390px,90%);aspect-ratio:1; }.orbit-b { width:min(300px,72%);aspect-ratio:1;border-style:dashed;animation:page-orbit 42s linear infinite; }.orbit-c { width:min(205px,52%);aspect-ratio:1;border-color:#bce88e42; }
  .page-art-core { position:relative;z-index:1;width:150px;height:150px;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:50%;background:radial-gradient(circle at 34% 25%,#24665c,#0d343c 72%);box-shadow:0 0 0 1px #b9ed9d44,inset 0 0 0 8px #fff1,0 0 75px #77d7a933; }
  .page-art-core span { color:#d3f6a3;font-size:42px;font-weight:800;letter-spacing:-.08em; }.page-art-core small { margin-top:6px;color:#b0d2c4;font-size:7px;letter-spacing:.16em; }
  .page-hero-canvas { position:absolute;inset:0;width:100%;height:100%;z-index:2; }
  .page-art-caption { position:absolute;bottom:8%;left:50%;white-space:nowrap;transform:translateX(-50%);color:#9cbdb2;font-size:9px;font-weight:700;letter-spacing:.19em; }.page-art-caption b { margin-left:8px;color:#c9ed97;font-size:15px; }
  .page-hero-bottom { position:absolute;bottom:0;left:0;right:0;height:48px;border-top:1px solid #d4eddf1a;display:flex;align-items:center;justify-content:space-between;padding:0 max(5vw,calc((100vw - 1180px)/2));color:#759692;font-size:8px;font-weight:650;letter-spacing:.16em; }
  [data-variant="team"] .page-hero:before { background:radial-gradient(ellipse at 77% 47%,#386c6299,transparent 46%),linear-gradient(118deg,#101f34,#123943 65%,#102c37); }
  [data-variant="team"] .page-art-core { box-shadow:0 0 0 1px #c4e5ff44,inset 0 0 0 8px #fff1,0 0 75px #84c6eb33; }
  [data-variant="team"] .page-art-core span { color:#b7ddfa; }
  [data-variant="projects"] .page-hero:before { background:radial-gradient(ellipse at 77% 47%,#37685299,transparent 46%),linear-gradient(118deg,#102c32,#104742 65%,#172f35); }
  [data-variant="projects"] .page-art-core { box-shadow:0 0 0 1px #b4f0bc44,inset 0 0 0 8px #fff1,0 0 75px #71d98c33; }
  [data-variant="projects"] .page-art-core span { color:#b8f3af; }
  @keyframes page-orbit { to { transform:translate(-50%,-50%) rotate(360deg); } }
  @media(max-width:850px) { .page-hero { min-height:auto;padding:140px 0 65px; }.page-hero-layout { grid-template-columns:1fr;gap:0; }.page-hero-copy { max-width:700px; }.page-hero-art { min-height:350px;margin-top:12px; }.page-hero-bottom { padding:0 6vw; } }
  @media(max-width:520px) { .page-hero { padding-top:132px; }.page-hero-copy h1 { font-size:3.35rem; }.page-hero-description { font-size:15px; }.page-hero-actions { gap:20px;flex-wrap:wrap; }.page-hero-footnote { margin-top:32px; }.page-hero-art { min-height:310px; }.page-hero-bottom { height:40px;font-size:6px;letter-spacing:.1em; } }
  @media(prefers-reduced-motion:reduce) { .orbit-b { animation:none; }.page-hero-primary { transition:none; } }
</style>

<script>
  import * as THREE from "three";

  const canvas = document.currentScript?.parentElement?.querySelector<HTMLCanvasElement>(".page-hero-canvas")
    ?? document.querySelector<HTMLCanvasElement>(".page-hero-canvas");
  const host = canvas?.parentElement;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (canvas && host && !reducedMotion) {
    let renderer: THREE.WebGLRenderer | undefined;
    try {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
      camera.position.z = 7;
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: "low-power" });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));

      const root = new THREE.Group();
      scene.add(root);
      const variant = canvas.closest<HTMLElement>("[data-variant]")?.dataset.variant;
      const color = variant === "team" ? 0x9bd5fa : variant === "projects" ? 0xb1ec9e : 0xb9e889;
      const core = new THREE.Mesh(
        variant === "team" ? new THREE.IcosahedronGeometry(1.15, 1) : variant === "projects" ? new THREE.OctahedronGeometry(1.15, 1) : new THREE.DodecahedronGeometry(1.15, 1),
        new THREE.MeshBasicMaterial({ color, wireframe: true, transparent: true, opacity: 0.48 }),
      );
      root.add(core);
      const ringGeometry = new THREE.TorusGeometry(1.72, 0.009, 5, 120);
      const ringMaterial = new THREE.MeshBasicMaterial({ color: 0x9dd7bb, transparent: true, opacity: 0.25 });
      const rings = [0, 1, 2].map((index) => {
        const ring = new THREE.Mesh(ringGeometry, ringMaterial);
        ring.rotation.set(index * 0.72, index * 0.53, index * 0.37);
        root.add(ring);
        return ring;
      });
      const nodePositions: THREE.Vector3[] = [];
      const count = 38;
      for (let i = 0; i < count; i++) {
        const y = 1 - (i / (count - 1)) * 2;
        const radius = Math.sqrt(1 - y * y);
        const angle = Math.PI * (3 - Math.sqrt(5)) * i;
        nodePositions.push(new THREE.Vector3(Math.cos(angle) * radius * 2.15, y * 2.15, Math.sin(angle) * radius * 0.8));
      }
      const pointsGeometry = new THREE.BufferGeometry().setFromPoints(nodePositions);
      root.add(new THREE.Points(pointsGeometry, new THREE.PointsMaterial({ color, size: 0.045, transparent: true, opacity: 0.9 })));
      const linkVertices: THREE.Vector3[] = [];
      nodePositions.forEach((point, i) => {
        for (let j = i + 1; j < nodePositions.length; j++) {
          if (point.distanceTo(nodePositions[j]) < 0.9) linkVertices.push(point, nodePositions[j]);
        }
      });
      root.add(new THREE.LineSegments(new THREE.BufferGeometry().setFromPoints(linkVertices), new THREE.LineBasicMaterial({ color: 0x9bd9bd, transparent: true, opacity: 0.18 })));
      const dustPositions = new Float32Array(180 * 3);
      for (let i = 0; i < dustPositions.length; i++) dustPositions[i] = (Math.random() - 0.5) * 8;
      const dustGeometry = new THREE.BufferGeometry();
      dustGeometry.setAttribute("position", new THREE.BufferAttribute(dustPositions, 3));
      const dust = new THREE.Points(dustGeometry, new THREE.PointsMaterial({ color: 0xc5e999, size: 0.018, transparent: true, opacity: 0.6 }));
      scene.add(dust);

      let visible = true;
      let frame = 0;
      let pointer = { x: 0, y: 0 };
      const resize = () => {
        const { width, height } = host!.getBoundingClientRect();
        if (!width || !height) return;
        renderer!.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      };
      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(host);
      const intersectionObserver = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) animate(); });
      intersectionObserver.observe(host);
      const onPointer = (event: PointerEvent) => {
        const bounds = host!.getBoundingClientRect();
        pointer = { x: ((event.clientX - bounds.left) / bounds.width - 0.5) * 2, y: ((event.clientY - bounds.top) / bounds.height - 0.5) * 2 };
      };
      host.addEventListener("pointermove", onPointer, { passive: true });
      const animate = () => {
        if (!visible || frame) return;
        const tick = () => {
          if (!visible) { frame = 0; return; }
          root.rotation.y += 0.002 + pointer.x * 0.0008;
          root.rotation.x += (pointer.y * 0.12 - root.rotation.x) * 0.015;
          rings.forEach((ring, index) => { ring.rotation.z += (index % 2 ? -1 : 1) * (0.0008 + index * 0.0002); });
          dust.rotation.y -= 0.00015;
          renderer!.render(scene, camera);
          frame = requestAnimationFrame(tick);
        };
        frame = requestAnimationFrame(tick);
      };
      resize();
      animate();
      document.addEventListener("astro:before-swap", () => {
        cancelAnimationFrame(frame);
        resizeObserver.disconnect();
        intersectionObserver.disconnect();
        host!.removeEventListener("pointermove", onPointer);
        scene.traverse((object) => {
          if (object instanceof THREE.Mesh || object instanceof THREE.Points || object instanceof THREE.LineSegments) {
            object.geometry.dispose();
            const material = object.material;
            if (Array.isArray(material)) material.forEach((item) => item.dispose());
            else material.dispose();
          }
        });
        renderer!.dispose();
      }, { once: true });
    } catch {
      renderer?.dispose();
      host.classList.add("page-art-static");
    }
  }
</script>
